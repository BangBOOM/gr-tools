{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "types": ["vite/client", "node"],
    "strict": true, "allowJs": true, "skipLibCheck": true, "noEmit": true,
    "resolveJsonModule": true, "allowImportingTsExtensions": true
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "vite.config.ts"],
  "exclude": ["**/tests/**", "**/test/**"]
}
